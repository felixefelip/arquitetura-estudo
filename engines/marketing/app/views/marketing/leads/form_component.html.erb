<%# @type self: Marketing::Leads::FormComponent %>

<div class="compra-container">
  <div class="compra-grid">
    <div class="compra-form">
      <turbo-frame id="purchase_form">
        <div class="step" data-step="1">
          <%= form_for lead, url: marketing_leads_path, html: { class: "stepper-form", data: { turbo_frame: "purchase_form" } } do |f| %>
            <h2>Dados pessoais</h2>

            <div class="form-field">
              <%= f.label :full_name, "Nome completo" %>
              <%= f.text_field :full_name, required: true, class: "form-input" %>
            </div>

            <div class="form-field">
              <%= f.label :email, "E-mail" %>
              <%= f.email_field :email, required: true, class: "form-input" %>
            </div>

            <div class="form-actions">
              <%= f.submit "Próximo", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </turbo-frame>
    </div>

    <div class="compra-resumo">
      <div class="resumo-card">
        <div class="card-header">
          <h2>Informações da sua compra</h2>
          <p><%= plano[:nome] %></p>
        </div>

        <div class="card-content">
          <p class="valor-total">
            Valor total do plano <strong><%= plano[:valor] %></strong>
          </p>

          <p><%= plano[:total_cursos] %> cursos</p>

          <ul class="beneficios-list">
            <% plano[:beneficios].each do |beneficio| %>
              <li>- <%= beneficio %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
