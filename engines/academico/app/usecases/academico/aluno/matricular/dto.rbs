module Academico
  module Aluno
    class Matricular
      class Dto
        def self.validates: (*untyped) -> void
        def valid?: -> bool
        def invalid?: -> bool
        def errors: -> ActiveModel::Errors
        def validate!: -> void

        attr_reader cpf: String?

        attr_reader email: String?

        attr_reader nome: String?

        attr_reader senha: String?

        def initialize: (cpf: String?, nome: String?, email: String?) -> void

        def cpf!: -> String
        def email!: -> String
        def nome!: -> String

        private

        attr_writer cpf: String?

        attr_writer email: String?

        attr_writer nome: String?

        attr_writer senha: String?
      end
    end
  end
end
