<%= render Shared::HeaderComponent.new(usuario: @usuario, show_logout: true) %>

<div class="container">
  <div class="cursos-card">
    <div class="card-header">
      <h1>Cursos disponíveis</h1>
    </div>

    <div class="card-content">
      <div class="cursos-list">
        <% @cursos.each do |curso| %>
          <%= render Academico::Cursos::CardComponent.new(curso: curso) %>
        <% end %>
      </div>
    </div>
  </div>
</div>
