module Academico
  module Aluno
    module Repositories
      module ActiveRecord
        class Impl
          def adicionar: (aluno: untyped) -> untyped
          def buscar_por_cpf: (untyped cpf) -> untyped
          def buscar_por_email: (untyped email) -> untyped
          def buscar_todos: () -> untyped
        end
      end
    end
  end
end
