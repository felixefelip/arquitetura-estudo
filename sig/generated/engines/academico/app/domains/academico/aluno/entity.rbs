module Academico
  module Aluno
    class Entity
      attr_reader cpf: ::Shared::Cpf
      attr_reader email: Email
      attr_reader nome: String
      attr_reader telefones: untyped
      attr_reader senha: String?
      def initialize: (nome: String, email: String, cpf: String, senha: String?) -> void
      def adicionar_telefone: (ddd: untyped, numero: untyped) -> untyped

      private

      attr_writer cpf: ::Shared::Cpf
      attr_writer email: Email
      attr_writer nome: String
      attr_writer telefones: untyped
      attr_writer senha: String?
    end
  end
end
